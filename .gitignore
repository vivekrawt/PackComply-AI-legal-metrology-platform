# Dependencies and build output
node_modules/
dist/
build/

# Python environment for the OCR sidecar (ocr-service/). Recreate with
# `python -m venv .venv` and ocr-service/requirements.txt.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime data: SQLite database + immutable evidence store + OCR cache.
# Never commit inspection evidence; the demo data is regenerated by the seed.
server/data/

# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Logs and OS/editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Extracted PRD text (the source PDF is committed instead)
prd_text.txt

# Deck and chart build scratch, and the artefacts it renders. Generated, large,
# and regenerable: sih26-deck.json alone reaches 120MB because the slide
# definitions carry their images inline as base64, which is over GitHub's hard
# 100MB per-file limit. Finished decks belong in a release or a drive, not in
# history — every push would carry them forever.
.ppt-build/
.chart-data-*/
output/

# Field photographs used for manual testing. Evidence images are never committed:
# the demo data is regenerated by the seed.
IMG_*.jpeg
IMG_*.jpg
