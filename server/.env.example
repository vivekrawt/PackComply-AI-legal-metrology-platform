# PackComply AI server configuration (all optional in local dev)

PORT=4000
NODE_ENV=development

# REQUIRED in any real deployment — sessions + signed asset URLs
PACKCOMPLY_SECRET=change-me-to-a-long-random-string

# Storage (defaults: ./data)
#PACKCOMPLY_DATA_DIR=./data
#PACKCOMPLY_DB_PATH=./data/packcomply.db
#PACKCOMPLY_EVIDENCE_DIR=./data/evidence

# Sessions (IAM-05)
SESSION_INACTIVITY_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_MAX_CONCURRENT=3

# Uploads
UPLOAD_MAX_BYTES=26214400

# AI providers. 'mock' = deterministic demo. The system never silently substitutes.
#
# OCR has two REAL self-hosted engines. Neither falls back to the other: an
# engine that is configured but cannot run fails the job, rather than quietly
# changing what read the evidence.
#
#   paddle    (DEFAULT) PaddleOCR + OpenCV/Pillow image preparation, in the
#             Python sidecar in ocr-service/. Deskews, crops and enhances each
#             capture before reading it, and hands back the prepared image to be
#             stored as a derivative of the original. Needs the sidecar running:
#             `npm run ocr`, or `npm run dev` which starts it alongside the app.
#   tesseract tesseract.js (WASM, eng+hin), in-process. No image preparation and
#             no derivative, but no Python either. Language data (~15 MB)
#             downloads once into TESSERACT_CACHE_PATH, then runs offline.
#
# Evidence never leaves the deployment on either path. Both read JPEG/PNG/BMP
# (paddle also WebP); HEIC and PDF pages need a raster conversion step that is
# not bundled.
PROVIDER_QUALITY=mock
PROVIDER_OCR=mock
#PROVIDER_OCR=paddle
#PROVIDER_OCR=tesseract
#TESSERACT_LANGS=eng+hin
#TESSERACT_CACHE_PATH=./data/tessdata
PROVIDER_LAYOUT=mock
PROVIDER_EXTRACTION=mock
PROVIDER_FONT=mock
PROVIDER_MALWARE=noop

# ---- PaddleOCR sidecar (PROVIDER_OCR=paddle) ----
# Reached over loopback, so evidence never leaves the deployment. See ocr-service/.
#PADDLE_OCR_URL=http://127.0.0.1:8100
#PADDLE_TIMEOUT_MS=120000
#PADDLE_MAX_ATTEMPTS=3
# Image preparation (OpenCV/Pillow) applied before OCR. Set any to false to turn
# that step off without redeploying the sidecar.
#PADDLE_DESKEW=true
#PADDLE_CROP=true
#PADDLE_ENHANCE=true
# Keep the prepared image as a derivative of the original asset, so a report can
# show what the recogniser actually read. Costs roughly one extra image per
# capture; false skips storing it.
#PADDLE_STORE_PROCESSED_IMAGE=true

# Jobs / rate limits
JOB_POLL_MS=400
JOB_MAX_ATTEMPTS=3
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=10
ASSET_URL_TTL_SECONDS=300

# Seed
SEED_DEMO_PASSWORD=PackComply#2026

# ---- Compliance judge (field-officer scan flow) ----
# The LLM that reads the OCR text of a scanned package against the statutory
# corpus in assets/rules/. Set GEMINI_API_KEY and PROVIDER_COMPLIANCE defaults to
# 'gemini'; leave it unset and the server falls back to 'rule_engine', which is
# the deterministic pattern matcher and reports itself as NOT an AI assessment.
#GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite — cheapest tier that still accepts the whole
# statutory corpus (1M-token input window) and honours responseSchema. Other
# ids verified against the AI Studio key format: gemini-3.5-flash,
# gemini-3-flash-preview, gemini-2.5-flash, or the moving aliases
# gemini-flash-lite-latest / gemini-flash-latest.
#GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_TIMEOUT_MS=90000
#PROVIDER_COMPLIANCE=gemini
# Statutory corpus location (default: server/assets/rules)
#PACKCOMPLY_RULES_DIR=./assets/rules
